# ---------------------------------------------------------------
# Universal CRM - React frontend configuration (copy to .env)
# Only VITE_* variables reach the browser. NEVER put passwords or secrets here.
# ---------------------------------------------------------------

# Address of the separate PHP REST API (no trailing slash).
#   PHP built-in server:   http://localhost:8000
#   XAMPP / Apache:        http://localhost/universal-crm/backend      (see README)
VITE_API_BASE_URL=http://localhost:8000

# WhatsApp click-to-chat link base (the user presses Send in WhatsApp; nothing is sent automatically):
#   https://wa.me                               -> opens https://wa.me/<number>?text=<message>
#   https://web.whatsapp.com/send?phone=        -> opens ...send?phone=<number>&text=<message>
VITE_WHATSAPP_BASE_URL=https://wa.me
