# ------------------------------------------------------------------
# Universal CRM backend configuration. Copy to ".env" and edit.
# NEVER commit .env, and never put these values in the React app.
# ------------------------------------------------------------------
APP_ENV=local            # local | production
APP_DEBUG=false          # true shows technical error text in API responses (development only)
APP_TIMEZONE=Asia/Karachi

# --- MySQL / MariaDB (XAMPP defaults: user root, empty password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=universal_crm
DB_USER=root
DB_PASS=

# --- Browser access (CORS): the exact origin(s) of the React app, comma separated ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Sessions ---
TOKEN_TTL_HOURS=12

# --- Business registration ---
# true  = the login page offers "Register your business" (good for local testing)
# false = only the command line script can create businesses (recommended in production)
ALLOW_BUSINESS_REGISTRATION=true

# --- Email reminders (optional). Nothing is reported as "sent" unless the SMTP server accepts the message ---
# MAIL_DRIVER: smtp | log (writes to storage/mail.log, sends nothing) | disabled
MAIL_DRIVER=disabled
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls      # tls (STARTTLS, port 587) | ssl (port 465) | none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=crm@example.com
MAIL_FROM_NAME=Universal CRM
